# ─────────────────────────────────────────────────────────────────────────────
#  SAMOTWORKS — Environment Configuration
#  Copy this file to `.env` and fill in the values. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# ── Discord (required) ───────────────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications -> Bot -> Token
BOT_TOKEN=
# Application ID (Developer Portal -> General Information -> Application ID)
CLIENT_ID=
# Primary guild ID. Commands are registered here instantly (recommended).
# Leave empty to register commands globally (may take up to 1 hour to appear).
GUILD_ID=
# Comma separated list of Discord user IDs with full owner-level access.
OWNER_ID=

# ── Database (required) ──────────────────────────────────────────────────────
# Local:  mongodb://127.0.0.1:27017/samotworks
# Atlas:  mongodb+srv://user:pass@cluster.mongodb.net/samotworks
DATABASE_URL=mongodb://127.0.0.1:27017/samotworks
# Optional explicit database name (overrides the one in the URI)
DATABASE_NAME=

# ── Runtime ──────────────────────────────────────────────────────────────────
# production | development
NODE_ENV=production
# error | warn | info | debug | trace
LOG_LEVEL=info
# Write logs to ./logs as newline-delimited JSON in addition to stdout
LOG_TO_FILE=true
# Deploy (register) slash commands automatically on startup
AUTO_DEPLOY_COMMANDS=true

# ── Storage paths (relative paths resolve from the project root) ─────────────
TRANSCRIPT_DIR=transcripts
BACKUP_DIR=backups
LOG_DIR=logs

# ── Optional integrations ────────────────────────────────────────────────────
# Public base URL used to build transcript download links (optional).
# When set, transcripts are linked as: {TRANSCRIPT_BASE_URL}/{fileName}
TRANSCRIPT_BASE_URL=
# Optional NSFW / image classification endpoint. Leave blank to disable.
# The bot POSTs { url } and expects { nsfw: boolean, score: number }.
IMAGE_MODERATION_API_URL=
IMAGE_MODERATION_API_KEY=
# Optional URL reputation endpoint. Leave blank to use the built-in heuristics only.
# The bot POSTs { url } and expects { malicious: boolean, category: string }.
URL_REPUTATION_API_URL=
URL_REPUTATION_API_KEY=
